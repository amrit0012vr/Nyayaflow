# ==============================================================================
# NyayaFlow Judicial Core — Environment Configuration Template (OPS-03)
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, keys must be >= 32 characters and cannot match default examples (SEC-02).
APP_ENV=development

# Demo Mode: Enable seeded test personas, quick-login, and tamper demonstration
DEMO_MODE=true

# Security Secrets (Must be at least 32 characters in production)
SECRET_KEY=nyayaflow-super-secret-jwt-key-2026-bharat-hackathon-sec
MASTER_KEY=NyayaFlowMasterKeySecure202632B!
JWT_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=7

# Default Demo User Password (only active when DEMO_MODE=true)
DEMO_PASSWORD=NyayaDemo@2026

# Database Connection (Default: High-Performance SQLite; or PostgreSQL)
DATABASE_URL=sqlite:///./nyayaflow.db
# DATABASE_URL=postgresql://nyaya:nyayaflowsecurepass2026@localhost:5432/nyayaflow

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pluggable LLM Layer Settings (AI-01)
# Options: 'none' (deterministic offline fallback), 'ollama', 'openai_compatible'
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.2

# OCR Document Ingestion Settings
OCR_LANGS=eng+hin+ori

# File Upload Limit (in Megabytes, default 25 MB)
MAX_UPLOAD_MB=25

# Optional Feature Flags
ALLOW_GUEST_LEGAL_AID=false
CITIZEN_OTP_ENABLED=false
ANTIVIRUS_ENABLED=false

# Citizen Chat History Retention (Days before automated purge, default 30 days)
CHAT_RETENTION_DAYS=30
